# Compendium databases are generated by packs/build-packs.mjs from
# packs/_source/**.json. Only the source JSON belongs in version control;
# committing the LevelDB internals (.ldb / .log / CURRENT / LOCK / MANIFEST-*)
# floods diffs and conflicts on every rebuild.
packs/rnr-*/
!packs/_source/
node_modules/

# Foundry / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
